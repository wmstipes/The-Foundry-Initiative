{
  "schema": "forgeops.runbook-catalog/v1alpha1",
  "entries": [
    {
      "id": "metrics-api-investigation",
      "title": "Investigate Metrics API availability",
      "path": "docs/runbooks/restaurant-api-operator-runbook.md",
      "section": "Common Issue: Metrics API Not Available",
      "signals": [
        {
          "match": "exact",
          "checkId": "metrics-api-service",
          "deltaKinds": ["ADDED", "STATUS_CHANGED", "EVIDENCE_CHANGED"],
          "afterStatuses": ["WARN", "FAIL", "UNKNOWN"]
        }
      ]
    },
    {
      "id": "node-readiness",
