          "match": "prefix",
          "checkId": "routing.",
          "deltaKinds": ["ADDED", "STATUS_CHANGED", "EVIDENCE_CHANGED"],
          "afterStatuses": ["PASS"]
        }
      ]
    },
    {
      "id": "workload-rollout",
      "title": "Investigate workload rollout health",
      "path": "docs/runbooks/restaurant-api-operator-runbook.md",
      "section": "Common Issue: Deployment Does Not Roll Out",
      "signals": [
        {
          "match": "prefix",
          "checkId": "deployment.",
          "deltaKinds": ["ADDED", "STATUS_CHANGED", "EVIDENCE_CHANGED"],
          "afterStatuses": ["WARN", "FAIL", "UNKNOWN"]
        }
      ]
