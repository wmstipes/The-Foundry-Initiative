        {
          "match": "prefix",
          "checkId": "node.",
          "deltaKinds": ["ADDED", "STATUS_CHANGED", "EVIDENCE_CHANGED"],
          "afterStatuses": ["WARN", "FAIL", "UNKNOWN"]
        }
      ]
    },
    {
