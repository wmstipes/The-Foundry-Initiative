{
  "id": null,
  "uid": "signalforge-scrape-diagnostics",
  "title": "SignalForge Scrape and Replica Diagnostics",
  "tags": [
    "signalforge",
    "restaurant-api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 7,
      "title": "Per Pod scrape health",
      "type": "state-timeline",
      "description": "State timeline, legend `pod`:    Map 1 to `Scrape successful` and 0 to `Scrape failed`. Leave absent intervals as gaps. When discovery removes a Pod, its series disappears after staleness handling; absence is not the same as an explicit failed scrape. Use Panel 1 for current counts. Pod-level scrape health does not verify NodePort access.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"restaurant-api\",namespace=\"forge-restaurant\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "signalforge-prometheus"
          },
          "legendFormat": "{{pod}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Scrape failed",
                  "color": "red"
                },
                "1": {
                  "text": "Scrape successful",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.9
      }
    },
    {
      "id": 8,
      "title": "Scrape duration by Pod",
      "type": "timeseries",
      "description": "Time series, seconds:    Add the configured ten-second scrape timeout as a reference line. This metric is generated by Prometheus for application scrapes and requires no Prometheus self-scrape. A long scrape is diagnostic context, not a complete explanation of application latency.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds{job=\"restaurant-api\",namespace=\"forge-restaurant\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "signalforge-prometheus"
          },
          "legendFormat": "{{pod}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Scraped samples by Pod",
      "type": "timeseries",
      "description": "Time series, sample count:    Use this to notice instrumentation changes or unexpected cardinality growth. Counts can grow legitimately when more route/status combinations are exercised. This is samples per scrape, not total TSDB series, storage consumption, or a full cardinality audit.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_samples_scraped{job=\"restaurant-api\",namespace=\"forge-restaurant\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "signalforge-prometheus"
          },
          "legendFormat": "{{pod}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Application request rate by Pod (5m)",
      "type": "timeseries",
      "description": "Time series, requests/second:  ```promql sum by (pod) (   rate(restaurant_api_requests_total{     job=\"restaurant-api\",namespace=\"forge-restaurant\",traffic=\"application\"   }[5m]) ) ```  Uneven traffic is not necessarily a load-balancing fault: connection reuse and a small request sample can skew distribution. Apply `rate` before summing so counter resets are handled per series.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (\n  rate(restaurant_api_requests_total{\n    job=\"restaurant-api\",namespace=\"forge-restaurant\",traffic=\"application\"\n  }[5m])\n)",
          "datasource": {
            "type": "prometheus",
            "uid": "signalforge-prometheus"
          },
          "legendFormat": "{{pod}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Synthetic traffic rate (5m)",
      "type": "timeseries",
      "description": "Time series, requests/second, legend `path status`:  ```promql sum by (path, status) (   rate(restaurant_api_requests_total{     job=\"restaurant-api\",namespace=\"forge-restaurant\",traffic=\"synthetic\"   }[5m]) ) ```  The current synthetic paths are `/health`, `/ready`, and `/metrics`. Classification is by path, so a manual request to these endpoints is also synthetic; this label is not proof of caller identity. Keep it separate from application demand.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path, status) (\n  rate(restaurant_api_requests_total{\n    job=\"restaurant-api\",namespace=\"forge-restaurant\",traffic=\"synthetic\"\n  }[5m])\n)",
          "datasource": {
            "type": "prometheus",
            "uid": "signalforge-prometheus"
          },
          "legendFormat": "{{path}} {{status}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Unmatched application traffic (5m)",
      "type": "timeseries",
      "description": "Time series, requests/second, legend `status`:  ```promql sum by (status) (   rate(restaurant_api_requests_total{     job=\"restaurant-api\",namespace=\"forge-restaurant\",     traffic=\"application\",path=\"unmatched\"   }[5m]) ) ```  Request several distinct nonexistent paths during the bounded acceptance exercise and verify they share `path=\"unmatched\"`. There may be no series before the first unmatched request. Do not add raw URLs or query strings as labels to improve this panel.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (\n  rate(restaurant_api_requests_total{\n    job=\"restaurant-api\",namespace=\"forge-restaurant\",\n    traffic=\"application\",path=\"unmatched\"\n  }[5m])\n)",
          "datasource": {
            "type": "prometheus",
            "uid": "signalforge-prometheus"
          },
          "legendFormat": "{{status}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
