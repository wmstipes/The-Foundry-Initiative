{
  "id": null,
  "uid": "signalforge-istio-lab",
  "title": "SignalForge Istio Learning Lab",
  "tags": [
    "signalforge",
    "istio-lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Proxy scrape health",
      "type": "state-timeline",
      "description": "A missing or failed scrape means dashboard traffic data cannot be trusted.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"istio-lab\",namespace=\"forge-mesh-lab\"}",
          "legendFormat": "{{workload}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Requests by destination version (5m)",
      "type": "timeseries",
      "description": "Server side traffic by v1/v2; allow two scrapes and a five minute rate window.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (destination_version) (rate(istio_requests_total{job=\"istio-lab\",namespace=\"forge-mesh-lab\",reporter=\"destination\",destination_service_name=\"lab-api\",destination_service_namespace=\"forge-mesh-lab\"}[5m]))",
          "legendFormat": "{{destination_version}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Client responses by code (5m)",
      "type": "timeseries",
      "description": "Source reporter includes the injected /break 503 even when no server receives it.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (response_code) (rate(istio_requests_total{job=\"istio-lab\",namespace=\"forge-mesh-lab\",workload=\"lab-client\",reporter=\"source\",destination_service_name=\"lab-api\",destination_service_namespace=\"forge-mesh-lab\"}[5m]))",
          "legendFormat": "HTTP {{response_code}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Client 503 responses (5m)",
      "type": "timeseries",
      "description": "Expected to rise during the deliberate fault and stop rising after repair; old errors remain visible in the rolling five minute window.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(istio_requests_total{job=\"istio-lab\",namespace=\"forge-mesh-lab\",workload=\"lab-client\",reporter=\"source\",destination_service_name=\"lab-api\",destination_service_namespace=\"forge-mesh-lab\",response_code=\"503\"}[5m]))",
          "legendFormat": "503 count",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Client response time p95 (5m)",
      "type": "timeseries",
      "description": "No data without sufficient requests. Never interpret an empty percentile as zero latency.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{job=\"istio-lab\",namespace=\"forge-mesh-lab\",workload=\"lab-client\",reporter=\"source\",destination_service_name=\"lab-api\",destination_service_namespace=\"forge-mesh-lab\"}[5m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Proxy scrape duration",
      "type": "timeseries",
      "description": "Prometheus scrape timing; distinguish telemetry collection faults from application failures.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "signalforge-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds{job=\"istio-lab\",namespace=\"forge-mesh-lab\"}",
          "legendFormat": "{{workload}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
