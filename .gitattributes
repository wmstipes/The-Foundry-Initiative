* text=auto

# Repository-authored source and configuration use stable LF endings.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf

# Binary artifacts must never be line-ending normalized.
*.gif binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.whl binary
*.zip binary
