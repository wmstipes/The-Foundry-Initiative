{
  "name": "forge-yaml-workbench",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validators:check && vite build",
    "test": "vitest run",
    "schema:build": "node scripts/build-kubernetes-schema.mjs",
    "validators:build": "node scripts/build-kubernetes-validators.mjs",
    "validators:check": "node scripts/build-kubernetes-validators.mjs --check",
    "csp:check": "node scripts/check-browser-csp.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
